<?xml version="1.0" encoding="UTF-8"?>
<!--
  Safe template for GitHub: URL Rewrite + static asset caching (no host paths).

  On IIS/Plesk:
  1) Copy this file to web.config in the site root (or merge blocks into your existing web.config).
  2) Keep Plesk httpErrors / tracing / system.web on the server — do not commit
     paths like C:\Inetpub\vhosts\...

  Requires: IIS URL Rewrite module.

  Static caching (browser):
  - CSS/JS: public, max-age=604800 (7 days)
  - Images + fonts (png jpg jpeg gif svg webp woff woff2 ttf otf): public, max-age=2592000 (30 days)
  PHP/HTML are not matched; app may still send Cache-Control: no-store for HTML — those responses win.

  If static Cache-Control does not appear: IIS → site → URL Rewrite → View Server Variables → allow RESPONSE_Cache-Control.

  Storefront short URLs: ONE dynamic rule → storefront-dispatch.php (channel policy unchanged).
-->
<configuration>
  <system.webServer>
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <rewrite>
      <allowedServerVariables>
        <add name="RESPONSE_Cache-Control" />
      </allowedServerVariables>
      <rules>
        <rule name="OrangeStaticCacheCssJs" stopProcessing="true">
          <match url=".*\.(css|js)$" ignoreCase="true" />
          <action type="None" />
          <serverVariables>
            <set name="RESPONSE_Cache-Control" value="public, max-age=604800" />
          </serverVariables>
        </rule>
        <rule name="OrangeStaticCacheImagesFonts" stopProcessing="true">
          <match url=".*\.(png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|otf)$" ignoreCase="true" />
          <action type="None" />
          <serverVariables>
            <set name="RESPONSE_Cache-Control" value="public, max-age=2592000" />
          </serverVariables>
        </rule>
        <!--
          /{path_segment} / {path_segment}-ar / … /cart /track /signup /signin /verify-email /product/123
          يُحل path_segment من قاعدة البيانات (لوحة الإدارة → الواجهات).
        -->
        <rule name="OrangeStorefrontDynamic" stopProcessing="true">
          <match url="^([a-z0-9\-]+)(-ar|-hi|-ph)?(?:/(.*))?$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{R:1}" pattern="^(admin|api|assets|pages|includes|vendor|scripts|storefront-dispatch)$" negate="true" />
          </conditions>
          <action type="Rewrite" url="storefront-dispatch.php?sf_first={R:1}&amp;sf_langx={R:2}&amp;sf_tail={R:3}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
