<?xml version="1.0" encoding="UTF-8"?>
<!--
  Safe template for GitHub: URL Rewrite + static asset Cache-Control (no host paths).

  On IIS/Plesk:
  1) Copy this file to web.config in the site root (or merge the <rewrite> block
     into your existing web.config under <system.webServer>).
  2) Keep Plesk httpErrors / tracing / system.web on the server — do not commit
     paths like C:\Inetpub\vhosts\...

  Requires: IIS URL Rewrite module (install "URL Rewrite" for IIS if /tiktok 404s).

  Static files only — extensions matched below get:
    Cache-Control: public, max-age=2592000
  PHP/HTML/API responses are not matched by this rule; HTML may still send no-store
  via PHP (orange_send_html_no_cache_headers in config.php) — those headers are
  not overridden here.

  If RESPONSE_Cache-Control does not apply: IIS → site → URL Rewrite →
  View Server Variables → allow RESPONSE_Cache-Control.

  Storefront short URLs: ONE dynamic rule → storefront-dispatch.php (channel policy unchanged).
  New channels: set path_segment in Admin (e.g. instagram) — no web.config edit.
  Legacy per-channel rules were removed; see git history if you need them.

  If short URLs still 404:
  - web.config must sit next to index.php / pages/ (site physical root).
  - Subfolder site (e.g. /shop): put web.config in that folder; in .env.php set
    PUBLIC_BASE_PATH to "/shop" (or "shop").
  - nginx-only hosting: web.config is ignored — use nginx rewrite or long URLs
    (set STOREFRONT_FORCE_LONG_URLS => true in .env.php).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <allowedServerVariables>
        <add name="RESPONSE_Cache-Control" />
      </allowedServerVariables>
      <rules>
        <rule name="OrangeStaticCacheAssets" stopProcessing="true">
          <match url=".*\.(css|js|png|jpg|jpeg|gif|webp|svg|woff|woff2|ttf|otf)$" ignoreCase="true" />
          <action type="None" />
          <serverVariables>
            <set name="RESPONSE_Cache-Control" value="public, max-age=2592000" />
          </serverVariables>
        </rule>
        <!--
          /{path_segment} / {path_segment}-ar / … /cart /track /signup /signin /verify-email /product/123
          يُحل path_segment من قاعدة البيانات (لوحة الإدارة → الواجهات).
        -->
        <rule name="OrangeStorefrontDynamic" stopProcessing="true">
          <match url="^([a-z0-9\-]+)(-ar|-hi|-ph)?(?:/(.*))?$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{R:1}" pattern="^(admin|api|assets|pages|includes|vendor|scripts|storefront-dispatch)$" negate="true" />
          </conditions>
          <action type="Rewrite" url="storefront-dispatch.php?sf_first={R:1}&amp;sf_langx={R:2}&amp;sf_tail={R:3}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
